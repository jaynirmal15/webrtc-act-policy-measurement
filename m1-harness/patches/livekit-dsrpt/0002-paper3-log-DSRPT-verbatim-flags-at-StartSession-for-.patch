 1 file changed, 4 insertions(+)

diff --git a/pkg/service/roommanager.go b/pkg/service/roommanager.go
index b0820e1f..c72dbe73 100644
--- a/pkg/service/roommanager.go
+++ b/pkg/service/roommanager.go
@@ -485,6 +485,10 @@ func (r *RoomManager) StartSession(
 	}
 
 	enableWarp := !useOneShotSignallingMode && r.config.RTC.EnableWarp
+	pLogger.Infow("paper3 DSRPT stress: participant params",
+		"disableSenderReportPassThrough", r.config.RTC.DisableSenderReportPassThrough,
