From d1074c1383064903e63a4aa6639e93eb28107c03 Mon Sep 17 00:00:00 2001
From: Grok Bot <grok@local>
Date: Fri, 6 Nov 2026 00:04:32 -0500
Subject: [PATCH] paper3: add time-gated SR-NTP skew onset to pion-publisher

Add -sr-ntp-skew-onset-ms (default 0): forward SRs unmodified until T ms
after the publisher's first RTP frame, then apply SkewMs. Default 0 keeps
the published constant-offset mode unchanged. Records first-frame wall
time, first modified SR wall time and SR index in inject.meta.json.
---
 act_interceptor.go         | 18 +++++++----
 main.go                    | 15 +++++----
 sr_ntp_skew_interceptor.go | 66 ++++++++++++++++++++++++++++++++------
 3 files changed, 77 insertions(+), 22 deletions(-)

diff --git a/act_interceptor.go b/act_interceptor.go
index 1aae37b..319153a 100644
--- a/act_interceptor.go
+++ b/act_interceptor.go
@@ -20,13 +20,14 @@ const actURI = "http://www.webrtc.org/experiments/rtp-hdrext/abs-capture-time"
 // so expected sync_err = t_capture_audio − t_capture_video ≈ av_offset_ms
 // when policies preserve relative ACT (prereg formula).
 type ActStampInterceptorFactory struct {
-	DeltaInjectMs atomic.Int64
-	AVOffsetMs    atomic.Int64 // audio capture offset relative to video (ms)
-	LogMu         sync.Mutex
-	LogPath       string
-	logFile       *injectLogger
-	errCount      atomic.Int64
-	okCount       atomic.Int64
+	DeltaInjectMs    atomic.Int64
+	AVOffsetMs       atomic.Int64 // audio capture offset relative to video (ms)
+	FirstFrameUnixMs atomic.Int64 // wall ms of first RTP Write (any track); 0 until then
+	LogMu            sync.Mutex
+	LogPath          string
+	logFile          *injectLogger
+	errCount         atomic.Int64
+	okCount          atomic.Int64
 }
 
 func (f *ActStampInterceptorFactory) NewInterceptor(id string) (interceptor.Interceptor, error) {
@@ -78,6 +79,9 @@ func (w *actStampWriter) Write(header *rtp.Header, payload []byte, attributes in
 		avOff = time.Duration(w.factory.AVOffsetMs.Load()) * time.Millisecond
 	}
 	injectWallMs := now.UnixMilli()
+	if w.factory.FirstFrameUnixMs.CompareAndSwap(0, injectWallMs) {
+		fmt.Fprintf(os.Stderr, "act-interceptor: first frame wall_ms=%d mime=%s ssrc=%d\n", injectWallMs, w.mime, w.ssrc)
+	}
 	captureTime := now.Add(-delta).Add(avOff)
 	setErr := ""
 
