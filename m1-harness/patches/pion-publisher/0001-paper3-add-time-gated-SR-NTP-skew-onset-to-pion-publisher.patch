 	interceptors := []interceptor.Factory{factory}
 	if *srHoldMs > 0 {
@@ -105,8 +107,8 @@ func main() {
 		interceptors = append(interceptors, srSkew)
 	}
 
-	fmt.Printf("pion-publisher host=%s room=%s delta_inject_ms=%d av_offset_ms=%d stagger_start_ms=%d sr_hold_ms=%d sr_ntp_skew_ms=%d video=%s audio=%s inject_log=%s\n",
-		*host, *roomName, *deltaMs, *avOffsetMs, *staggerStart, *srHoldMs, *srNtpSkewMs, *videoPath, *audioPath, *injectLog)
+	fmt.Printf("pion-publisher host=%s room=%s delta_inject_ms=%d av_offset_ms=%d stagger_start_ms=%d sr_hold_ms=%d sr_ntp_skew_ms=%d sr_ntp_skew_onset_ms=%d video=%s audio=%s inject_log=%s\n",
+		*host, *roomName, *deltaMs, *avOffsetMs, *staggerStart, *srHoldMs, *srNtpSkewMs, *srNtpSkewOnsetMs, *videoPath, *audioPath, *injectLog)
 
 	room, err := lksdk.ConnectToRoom(*host, lksdk.ConnectInfo{
 		APIKey:              *apiKey,
@@ -205,9 +207,10 @@ func main() {
 	metaPath := strings.TrimSuffix(*injectLog, filepath.Ext(*injectLog)) + ".meta.json"
 	writeMeta := func() {
 		_ = os.WriteFile(metaPath, []byte(fmt.Sprintf(
-			`{"delta_inject_ms":%d,"av_offset_ms":%d,"stagger_start_ms":%d,"sr_hold_ms":%d,"sr_ntp_skew_ms":%d,"sr_ntp_skewed_count":%d,"sr_ntp_first_skew_unix_ms":%d,"sr_first_held_unix_ms":%d,"sr_first_released_unix_ms":%d,"sr_held_count":%d,"sr_released_count":%d,"act_negotiated":%v,"act_audio":%v,"act_video":%v,"audio_published":%v,"video":%q,"audio":%q,"started_unix_ms":%d}`+"\n",
-			*deltaMs, *avOffsetMs, *staggerStart, *srHoldMs, *srNtpSkewMs,
-			srSkew.SkewedCount.Load(), srSkew.FirstSkewUnixMs.Load(),
+			`{"delta_inject_ms":%d,"av_offset_ms":%d,"stagger_start_ms":%d,"sr_hold_ms":%d,"sr_ntp_skew_ms":%d,"sr_ntp_skew_onset_ms":%d,"sr_ntp_skewed_count":%d,"sr_ntp_unmodified_count":%d,"sr_ntp_sr_seen_count":%d,"sr_ntp_first_skew_unix_ms":%d,"sr_ntp_onset_sr_index":%d,"first_frame_unix_ms":%d,"sr_first_held_unix_ms":%d,"sr_first_released_unix_ms":%d,"sr_held_count":%d,"sr_released_count":%d,"act_negotiated":%v,"act_audio":%v,"act_video":%v,"audio_published":%v,"video":%q,"audio":%q,"started_unix_ms":%d}`+"\n",
+			*deltaMs, *avOffsetMs, *staggerStart, *srHoldMs, *srNtpSkewMs, *srNtpSkewOnsetMs,
+			srSkew.SkewedCount.Load(), srSkew.UnmodifiedCount.Load(), srSkew.SRSeenCount.Load(),
