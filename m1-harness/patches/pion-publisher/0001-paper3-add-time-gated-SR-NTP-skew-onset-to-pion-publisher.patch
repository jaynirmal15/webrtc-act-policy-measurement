diff --git a/sr_ntp_skew_interceptor.go b/sr_ntp_skew_interceptor.go
index 0f1f57c..cf7347e 100644
--- a/sr_ntp_skew_interceptor.go
+++ b/sr_ntp_skew_interceptor.go
@@ -18,11 +18,21 @@ import (
 // becomes ≈ AtAdjusted−Ntp ≈ estimated OWD ≈ SkewMs, so captureTimestamp shifts
 // and latency bias b = L̂−L* should approach −SkewMs. Verbatim skips Rewrite,
 // so bias should stay near 0 under the same skew.
+//
+// OnsetDelayMs: when 0 (default), every SR is skewed — the published constant-offset
+// mode. When >0, SRs are forwarded unmodified until OnsetDelayMs after the publisher's
+// first RTP frame (FirstFrameUnixMs), then skewed from the next SR onward.
 type SRNtpSkewInterceptorFactory struct {
-	SkewMs       atomic.Int64
-	SkewedCount  atomic.Int64
-	FirstSkewUnixMs atomic.Int64
-	LastSkewMsApplied atomic.Int64
+	SkewMs              atomic.Int64
+	OnsetDelayMs        atomic.Int64
+	FirstFrameUnixMs    *atomic.Int64 // shared with ACT factory; 0 until first frame
+	SkewedCount         atomic.Int64
+	UnmodifiedCount     atomic.Int64
+	SRSeenCount         atomic.Int64
+	FirstSkewUnixMs     atomic.Int64
+	LastSkewMsApplied   atomic.Int64
+	OnsetSRIndex        atomic.Int64 // 1-based SR index of first modified SR; 0 if none
+	FirstFrameSeenMs    atomic.Int64 // copy of first-frame wall time when onset armed
 }
 
 func (f *SRNtpSkewInterceptorFactory) NewInterceptor(id string) (interceptor.Interceptor, error) {
@@ -53,26 +63,64 @@ func ntpSubtractMs(ntp uint64, ms int64) uint64 {
 func (s *srNtpSkewInterceptor) BindRTCPWriter(writer interceptor.RTCPWriter) interceptor.RTCPWriter {
 	return interceptor.RTCPWriterFunc(func(pkts []rtcp.Packet, attributes interceptor.Attributes) (int, error) {
 		skew := s.factory.SkewMs.Load()
+		onsetMs := s.factory.OnsetDelayMs.Load()
 		if skew == 0 {
 			return writer.Write(pkts, attributes)
 		}
+		nowMs := time.Now().UnixMilli()
 		for _, p := range pkts {
 			sr, ok := p.(*rtcp.SenderReport)
 			if !ok {
 				continue
 			}
+			srIdx := s.factory.SRSeenCount.Add(1)
+
+			// Time-gated onset: forward unmodified until first_frame + T.
+			apply := true
+			if onsetMs > 0 {
+				var firstFrame int64
+				if s.factory.FirstFrameUnixMs != nil {
+					firstFrame = s.factory.FirstFrameUnixMs.Load()
+				}
+				if firstFrame == 0 {
+					apply = false
+				} else {
+					if s.factory.FirstFrameSeenMs.Load() == 0 {
+						s.factory.FirstFrameSeenMs.Store(firstFrame)
+					}
+					if nowMs < firstFrame+onsetMs {
+						apply = false
+					}
+				}
+			}
+
+			if !apply {
+				s.factory.UnmodifiedCount.Add(1)
+				if srIdx <= 3 || srIdx%50 == 0 {
+					fmt.Fprintf(os.Stderr, "sr-ntp-skew: SR#%d UNMODIFIED (onset_ms=%d first_frame=%d now=%d)\n",
+						srIdx, onsetMs, func() int64 {
+							if s.factory.FirstFrameUnixMs == nil {
+								return 0
+							}
+							return s.factory.FirstFrameUnixMs.Load()
+						}(), nowMs)
+				}
+				continue
+			}
+
 			before := sr.NTPTime
 			sr.NTPTime = ntpSubtractMs(before, skew)
 			n := s.factory.SkewedCount.Add(1)
 			s.factory.LastSkewMsApplied.Store(skew)
 			if s.factory.FirstSkewUnixMs.Load() == 0 {
-				s.factory.FirstSkewUnixMs.Store(time.Now().UnixMilli())
-				fmt.Fprintf(os.Stderr, "sr-ntp-skew: first SR NTP skewed by %d ms (before=0x%x after=0x%x)\n",
-					skew, before, sr.NTPTime)
+				s.factory.FirstSkewUnixMs.Store(nowMs)
+				s.factory.OnsetSRIndex.Store(srIdx)
+				fmt.Fprintf(os.Stderr, "sr-ntp-skew: ONSET first modified SR#%d skew_ms=%d onset_delay_ms=%d first_frame_unix_ms=%d (before=0x%x after=0x%x)\n",
+					srIdx, skew, onsetMs, s.factory.FirstFrameSeenMs.Load(), before, sr.NTPTime)
 			}
 			if n <= 3 || n%50 == 0 {
-				fmt.Fprintf(os.Stderr, "sr-ntp-skew: count=%d skew_ms=%d ntp_before=0x%x ntp_after=0x%x\n",
-					n, skew, before, sr.NTPTime)
+				fmt.Fprintf(os.Stderr, "sr-ntp-skew: count=%d sr_index=%d skew_ms=%d ntp_before=0x%x ntp_after=0x%x\n",
+					n, srIdx, skew, before, sr.NTPTime)
 			}
 		}
 		return writer.Write(pkts, attributes)
