diff --git a/pkg/rtc/types/typesfakes/fake_local_participant.go b/pkg/rtc/types/typesfakes/fake_local_participant.go
index b6f349e7..9fed1922 100644
--- a/pkg/rtc/types/typesfakes/fake_local_participant.go
